# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Public URL people use to reach Kōwhai, behind your reverse proxy.
KOWHAI_BASE_URL=https://kowhai.example.com
# Only trust X-Forwarded-For from your proxy. IPs or CIDRs, comma separated.
KOWHAI_TRUSTED_PROXIES=172.16.0.0/12

# OIDC client registered with Kanidm or Authelia.
# Redirect URI: <KOWHAI_BASE_URL>/auth/callback
KOWHAI_OIDC_ISSUER=https://idm.example.com/oauth2/openid/kowhai
KOWHAI_OIDC_CLIENT_ID=kowhai
KOWHAI_OIDC_CLIENT_SECRET=change-me
# Members of this group are site admins. Kanidm sends name@domain; either form works.
KOWHAI_OIDC_ADMIN_GROUP=kowhai_admins
# These emails are always site admins.
KOWHAI_ADMIN_EMAILS=

# Garage. The key ID is GK followed by 24 hex characters. The secret is 64 hex characters.
GARAGE_RPC_SECRET=91e3d3a692cc15d088d638049194be817b1f9b9d48e75a6c7d365ffd522e3e8a
GARAGE_ADMIN_TOKEN=ce62457681c3cc8352b397003dd79ceddcfeeca34c4b24cc3b9b8fafd6131271
KOWHAI_S3_ACCESS_KEY=GKf5e203c749583c73edb509fb
KOWHAI_S3_SECRET_KEY=b9a628bf615daada879bb642a81023a7e9d4026854e568bee8d2cd9496e250c6
KOWHAI_S3_BUCKET=kowhai-attachments
KOWHAI_S3_BACKUP_BUCKET=kowhai-backups

KOWHAI_MAX_UPLOAD_MB=25
