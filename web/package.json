{
  "name": "kowhai-web",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && touch dist/.keep",
    "gen": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.45",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/markdown-it": "14.2.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
