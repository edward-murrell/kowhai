{
  "name": "kowhai-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && touch dist/.keep",
    "gen": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "dompurify": "3.2.6",
    "markdown-it": "14.1.0",
    "openapi-fetch": "0.14.1",
    "pinia": "3.0.4",
    "reka-ui": "2.5.1",
    "vue": "3.5.22",
    "vue-draggable-plus": "0.6.0",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/markdown-it": "14.1.2",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.9.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.0"
  }
}
